# syntax=docker/dockerfile:1.6
# =====================================================================
# PPT Master Bridge 镜像（hugohe3/ppt-master + WeKnora FastAPI 网关）
# =====================================================================

FROM python:3.11-slim AS base

ARG APT_MIRROR=""
ARG PIP_INDEX_URL="https://pypi.org/simple"
ARG PPTMASTER_GIT_REPO="https://github.com/hugohe3/ppt-master.git"
ARG PPTMASTER_GIT_REF="main"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PPTMASTER_REPO_ROOT=/opt/ppt-master

WORKDIR /opt/pptmaster

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s@deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources || true; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
        git \
        libxml2 \
        libxslt1.1 \
        libjpeg62-turbo \
        libpng16-16 \
        libgomp1 \
        libcairo2 \
        libreoffice-core \
        libreoffice-writer \
        libreoffice-impress \
        libreoffice-calc \
        fontconfig \
        fonts-noto-cjk \
        fonts-noto-color-emoji \
        pandoc \
        poppler-utils && \
    rm -rf /var/lib/apt/lists/*

RUN rm -rf /opt/ppt-master && \
    git clone --depth 1 --branch "${PPTMASTER_GIT_REF}" "${PPTMASTER_GIT_REPO}" /opt/ppt-master

COPY integrations/pptmaster_bridge /opt/pptmaster_bridge

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --cache-dir=/root/.cache/pip --upgrade pip && \
    pip install --cache-dir=/root/.cache/pip -r /opt/ppt-master/skills/ppt-master/requirements.txt && \
    pip install --cache-dir=/root/.cache/pip -r /opt/pptmaster_bridge/requirements.txt

ENV PYTHONPATH=/opt:/opt/ppt-master/skills/ppt-master/scripts

RUN mkdir -p /data/pptmaster
VOLUME ["/data/pptmaster"]

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=90s \
    CMD curl -fsS http://127.0.0.1:8090/health || exit 1

CMD ["python", "-m", "pptmaster_bridge"]
