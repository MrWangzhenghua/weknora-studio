# 闪卡 Bridge：轻量 Python 服务，将知识库 Markdown 交给 OpenAI 兼容接口生成闪卡 JSON。
# 设计对齐 docker/Dockerfile.pptagent 的「独立 sidecar」思路，不包含 genai-rag 全量依赖。

FROM python:3.11-slim

ARG APT_MIRROR=
ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL}

WORKDIR /opt

RUN if [ -n "$APT_MIRROR" ]; then sed -i "s|deb.debian.org|$APT_MIRROR|g" /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY integrations/flashcard_bridge /opt/flashcard_bridge

RUN pip install --retries 5 --default-timeout 120 -r /opt/flashcard_bridge/requirements.txt

ENV PYTHONPATH=/opt

EXPOSE 8091

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8091/health || exit 1

CMD ["python", "-m", "flashcard_bridge"]
