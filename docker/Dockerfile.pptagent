# syntax=docker/dockerfile:1.6
# =====================================================================
# PPTAgent Bridge 镜像
# 提供 WeKnora 调用的 HTTP 网关 + 内置 PPTAgent 生成能力
#
# 说明：上游 PPTAgent 体积较大，很多 fork 未包含子模块；构建阶段从 GitHub
# 浅克隆指定分支/标签，避免 COPY 空目录导致 pip install -e 失败。
# =====================================================================

FROM python:3.11-slim AS base

ARG APT_MIRROR=""
ARG PIP_INDEX_URL="https://pypi.org/simple"
# 可覆盖为国内镜像或固定 commit 对应的 tag，保证可复现构建
ARG PPTAGENT_GIT_REPO="https://github.com/icip-cas/PPTAgent.git"
ARG PPTAGENT_GIT_REF="main"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_INDEX_URL=${PIP_INDEX_URL}

WORKDIR /opt/pptagent

# 系统依赖（PPTAgent 解析 PDF/Office 等需要）；git 用于克隆上游仓库
# apt / pip 使用 BuildKit 缓存，重复 compose build 时显著加速
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    if [ -n "${APT_MIRROR}" ]; then \
        sed -i "s@deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources || true; \
    fi && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ca-certificates \
        git \
        libxml2 \
        libxslt1.1 \
        libjpeg62-turbo \
        libpng16-16 \
        libgomp1 \
        libreoffice-core \
        libreoffice-writer \
        libreoffice-impress \
        libreoffice-calc \
        fontconfig \
        fonts-noto-cjk \
        fonts-noto-color-emoji \
        poppler-utils && \
    rm -rf /var/lib/apt/lists/*

# 从官方仓库获取 PPTAgent（构建机需能访问 Git；内网可改用 PPTAGENT_GIT_REPO 指向镜像站）
RUN rm -rf /opt/PPTAgent && \
    git clone --depth 1 --branch "${PPTAGENT_GIT_REF}" "${PPTAGENT_GIT_REPO}" /opt/PPTAgent

COPY integrations/pptagent_bridge /opt/pptagent_bridge

# 安装 PPTAgent（editable 安装，便于开发时在 compose 里挂载覆盖 bridge）
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --cache-dir=/root/.cache/pip --upgrade pip && \
    pip install --cache-dir=/root/.cache/pip -e /opt/PPTAgent && \
    pip install --cache-dir=/root/.cache/pip -r /opt/pptagent_bridge/requirements.txt

# 把 bridge 包加入 Python 搜索路径
ENV PYTHONPATH=/opt:/opt/PPTAgent

# 默认工作区（生成的 PPT、临时文件都会在这里）
# HF_HOME：Hugging Face 缓存目录，与 docker-compose 中 pptagent-hf-cache 卷对应，避免冷启动反复拉模型
ENV HF_HOME=/data/huggingface
RUN mkdir -p /data/pptagent /data/huggingface
VOLUME ["/data/pptagent", "/data/huggingface"]

EXPOSE 8090

# 健康检查：调用 /health 接口
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD curl -fsS http://127.0.0.1:8090/health || exit 1

CMD ["python", "-m", "pptagent_bridge"]
